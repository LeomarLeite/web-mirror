# WebMirror — modelo de configuração. Copie para .env e ajuste.
# Vale para os dois jeitos de rodar: Docker (docker compose) e sem Docker (npm start).

# --- Docker ---
# Porta no seu computador (faixa do projeto: 187xx). Dentro do container é sempre 3000.
WEBMIRROR_HOST_PORT=18780
# Interface onde a porta fica aberta. 127.0.0.1 = só este computador.
WEBMIRROR_BIND=127.0.0.1

# --- Sem Docker (npm start) ---
PORT=18780
# DOWNLOAD_DIR=./downloads

# --- Captura ---
# Aviso quando o .zip passar deste tamanho.
MAX_ZIP_SIZE_MB=50
# Arquivo estático maior que isto não é baixado (fica apontando para o site original).
MAX_ASSET_SIZE_MB=5
MAX_ASSETS=1500
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
NAVIGATION_TIMEOUT_MS=45000
NETWORK_IDLE_TIMEOUT_MS=15000
JOB_TIMEOUT_MS=180000
# Horas que o .zip fica guardado em downloads/ (0 = para sempre).
ZIP_RETENTION_HOURS=24
# true libera capturar endereços da rede local (localhost, 192.168.x.x...). Padrão: bloqueado.
ALLOW_PRIVATE_NETWORKS=false
# Domínios extras cujos vídeos/iframes ficam online (além de YouTube e Vimeo), separados por vírgula.
EMBED_HOSTS=

# --- Modo interativo (site com verificação, ex.: Cloudflare) ---
# Abre uma janela visível do navegador para VOCÊ passar pela verificação e só então capturar.
# Precisa de uma tela: funciona rodando a app direto na sua máquina (npm start).
# Dentro do container (docker) não há tela por padrão, então deixe desligado lá.
INTERACTIVE_ENABLED=true
# Pasta do perfil do navegador interativo (guarda cookies para não refazer a verificação).
# PROFILE_DIR=./.webmirror-profile
# Tempo (ms) que a janela fica aberta esperando você antes de desistir sozinha.
INTERACTIVE_IDLE_TIMEOUT_MS=300000
